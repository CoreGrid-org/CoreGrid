# Values substituted into infra/thunderid/coregrid.yaml when ThunderID starts.
# setup.sh copies this file to environment.env (git-ignored) and fills in
# CORE_GRID_BACKEND_CLIENT_SECRET. Never commit a real secret.
# JSON-array values must stay on one line.

# ThunderID's own management console
CONSOLE_CLIENT_ID=CONSOLE
CONSOLE_REDIRECT_URIS=["https://localhost:8090/console"]

# CoreGrid Frontend — React SPA, public PKCE client (frontend/.env VITE_THUNDERID_CLIENT_ID)
CORE_GRID_FRONTEND_CLIENT_ID=fKnymA9VexqbkvbBpx-uSA
CORE_GRID_FRONTEND_REDIRECT_URIS=["http://localhost:5173"]

# CoreGrid Backend — confidential client_credentials client (backend ThunderID__ScimClientId / __ScimClientSecret)
CORE_GRID_BACKEND_CLIENT_ID=6ksZV1mJWUQQLz1YCJQ_8A
CORE_GRID_BACKEND_CLIENT_SECRET=
CORE_GRID_BACKEND_REDIRECT_URIS=[]

# CoreGrid Mobile — Flutter, public PKCE client with a custom-scheme redirect (coregrid-mobile .env.json THUNDERID_CLIENT_ID)
CORE_GRID_MOBILE_CLIENT_ID=Ok35LLY76ZrK-5j1qsJCxQ
CORE_GRID_MOBILE_REDIRECT_URIS=["com.coregrid.mobile://auth-callback"]
