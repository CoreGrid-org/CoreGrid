# CoreGrid Agentic AI Subsystem - Environment Configuration

# 1. LLM Model Provider Configuration (SRS §14.2)
# Supported providers: google_genai | openai | anthropic
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-2.0-flash

# Model API Key (SRS §14.2 naming: Model__ApiKey)
# Also accepts GEMINI_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY
Model__ApiKey=your_model_api_key_here

# 2. CoreGrid Backend API
BACKEND_API_URL=http://localhost:5000

# 3. ThunderID Service Account (M2M OAuth2 Token Endpoint)
THUNDERID_TOKEN_URL=https://localhost:8090/oauth2/token
THUNDERID_RESOURCE=https://localhost:8090/mcp
AGENT_CLIENT_ID=your_thunderid_client_id_here
AGENT_CLIENT_SECRET=your_thunderid_service_secret_here
