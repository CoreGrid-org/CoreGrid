# CoreGrid API — environment configuration
#
# Copy to backend/.env (git-ignored); ./setup.sh does this for you.
#
# How it is read:
#   • `dotnet run` (local): Program.cs loads backend/.env at start-up.
#   • Docker:               docker run --env-file backend/.env -p 8080:8080 coregrid-api:local
#   • Cloud host:           enter the same names as application settings.
#
# appsettings*.json hold only logging; every environment-specific value and secret lives
# here (or in real environment variables, which always win over this file). Blank values are
# ignored. The defaults below match the local Docker setup and the reference ThunderID
# configuration in infra/thunderid/; change the IDs if your ThunderID instance differs.
# A double underscore "__" separates nested keys (ThunderID__Issuer = ThunderID:Issuer).

# ASPNETCORE_ENVIRONMENT=Development   # `dotnet run` already sets this via launchSettings.json

# ── Database ────────────────────────────────────────────────────────────────
# Choose ONE.

# Local Docker Postgres (docker-compose.yml, host port 5433)
ConnectionStrings__CoreGrid=Host=localhost;Port=5433;Database=coregrid;Username=coregrid;Password=coregrid

# Supabase — session pooler (IPv4; use from Azure, Docker or most networks).
# Dashboard → Connect → Session pooler. Port 5432 (session mode), NOT 6543 (transaction
# mode breaks Npgsql prepared statements).
# ConnectionStrings__CoreGrid=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<database-password>;SSL Mode=Require;Maximum Pool Size=10;Timeout=30

# Supabase — direct connection (IPv6-only on the free plan)
# ConnectionStrings__CoreGrid=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<database-password>;SSL Mode=Require;Maximum Pool Size=10

# ── API documentation ───────────────────────────────────────────────────────
# /swagger is on in every environment by default (SRS OPS-02). Set false to hide it.
# Swagger__Enabled=true

# ── CORS — web-app origins (__0, __1, …) ────────────────────────────────────
Cors__AllowedOrigins__0=http://localhost:5173

# ── ThunderID (docs/setup/thunderid.md) ─────────────────────────────────────
ThunderID__Issuer=https://localhost:8090
ThunderID__Resource=https://localhost:8090/mcp
ThunderID__OuId=01900000-0000-7000-8000-000000000001
ThunderID__UserType=CoreGridUser
ThunderID__RoleIds__Administrator=019fe6ae-67e4-7293-9bdd-3ce56712a19e
ThunderID__RoleIds__InventoryOfficer=019fe683-4677-7078-9f66-bf47c84ff173
ThunderID__RoleIds__Auditor=019fe683-7167-7cb3-8728-efa922aae3e8
ThunderID__RoleIds__Staff=019fe683-c2cc-7c2c-864f-132ef2ac86a5
# CoreGrid Backend application (client_credentials, client_secret_post)
ThunderID__ScimClientId=6ksZV1mJWUQQLz1YCJQ_8A
ThunderID__ScimClientSecret=

# ── Agents / language model (docs/setup/ai-agents.md) ───────────────────────
# Without any key the Planner and Budget agents use their deterministic fallbacks.
Llm__ApiKey=
# Llm__Endpoint=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Llm__Model=gemini-3.5-flash

# Optional fallback provider, tried when the primary fails (error, 429, timeout, bad output).
# Groq's OpenAI-compatible endpoint and gpt-oss-120b by default. Leave the key blank to disable.
LlmFallback__ApiKey=
# LlmFallback__Endpoint=https://api.groq.com/openai/v1/chat/completions
# LlmFallback__Model=openai/gpt-oss-120b

# ── Photo evidence storage (docs/setup/cloudflare-r2.md) ────────────────────
CloudflareR2__AccountId=
CloudflareR2__AccessKeyId=
CloudflareR2__SecretAccessKey=
CloudflareR2__BucketName=
